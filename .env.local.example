NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REPLICATE_API_TOKEN=
# Optional. 'trellis' (default) or 'hunyuan3d'. Selects which Replicate model generates meshes.
REPLICATE_MODEL_FAMILY=
# Optional. Defaults to the pinned firtoz/trellis version used by the adapter.
REPLICATE_MODEL_VERSION=
# Optional. Defaults to the pinned tencent/hunyuan3d-2mv version used by the adapter.
HUNYUAN3D_MODEL_VERSION=

# Preferred high-detail face/head worker. When configured, this provider takes priority over Replicate.
HEAD_RECONSTRUCTION_API_URL=
HEAD_RECONSTRUCTION_API_KEY=
HEAD_RECONSTRUCTION_MODEL_NAME=hybrid-flame-head-v1
# Comma-separated hosts allowed to serve completed GLB files.
HEAD_RECONSTRUCTION_OUTPUT_HOSTS=

# PRD v2.0 photogrammetry scan worker (video/photo-set reconstruction, Modal GPU).
SCAN_RECONSTRUCTION_API_URL=
SCAN_RECONSTRUCTION_API_KEY=
SCAN_RECONSTRUCTION_MODEL_NAME=photogrammetry-colmap-v1
